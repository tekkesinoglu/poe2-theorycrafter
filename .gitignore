@"
# Bağımlılıklar (npm install ile geri gelir)
node_modules/
dist/
dist-ssr/

# Rust & Tauri derleme çıktıları (4+ GB yer kaplayan klasör)
src-tauri/target/
src-tauri/gen/schemas/

# İndirilen büyük önbellek / yama verileri
game_data.bin
*.pdb
*.exe
*.msi
*.dmg
*.AppImage

# Editör ve sistem dosyaları
.DS_Store
Thumbs.db
.vscode/
.idea/
*.log
"@ | Out-File -FilePath .gitignore -Encoding utf8

git init
git add .
git commit -m "feat: initial working PoE2 Theorycrafter build"